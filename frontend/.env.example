# Public configuration only. NEVER put secrets here - Vite exposes VITE_* to
# the browser. Secrets (Gemini, MongoDB, JWT, Bhashini) stay server-side.
VITE_API_URL=

# Demo convenience only: shows the VIEW AS role switcher in the top bar.
# It only navigates — ProtectedRoute + backend authorization still enforce
# the real role, so it can never bypass access control.
# VITE_DEMO_MODE=true
