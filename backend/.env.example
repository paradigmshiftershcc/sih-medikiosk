# Variables NAMES ONLY - never commit real values.
# Copy to .env for local development and set real values there.

PORT=5000
NODE_ENV=development

# Backend environment variables (server-side only). Never mirror these to the
# frontend - Vite exposes only VITE_* variables to the browser.

# MongoDB connection string
MONGO_URI=

# JWT signing secret - REQUIRED in production
JWT_SECRET=

# Google Gemini API key
GEMINI_API_KEY=

# Gemini model chain (verified catalog ids only — invented ids are rejected).
# Calls run HEDGED: the primary starts immediately, fallbacks start staggered
# so one slow/overloaded model never blocks the turn. First success wins.
# Primary baseline:
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated hedged fallbacks (default: newer Flash models, Lite last):
# GEMINI_MODEL_FALLBACKS=gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# Failover tuning (milliseconds):
# GEMINI_HEDGE_DELAY_MS=2000
# GEMINI_CHAT_TIMEOUT_MS=8000
# GEMINI_ASSESS_TIMEOUT_MS=20000
# GEMINI_AFFECT_TIMEOUT_MS=15000
# GEMINI_MODEL_COOLDOWN_MS=30000

# Optional Gemini audio-affect layer (observable speech characteristics,
# in-memory only, never persisted). Deterministic indicators always run.
ENABLE_VOICE_AFFECT_AI=false

# Data retention: raw voice recordings are never persisted (must stay 0).
RAW_AUDIO_RETENTION=0

# Comma-separated list of allowed frontend origins for CORS.
# Example: https://sahaay.vercel.app,https://sahaay-preview.vercel.app
# Leave empty for local development (localhost is always allowed).
FRONTEND_URL=

# Bhashini is strictly opt-in. Leave false until live credentials are
# approved; the voice layer uses the Sarvam fallback while disabled.
BHASHINI_ENABLED=false

# Bhashini credentials (service architecture kept intact, backend only).
# BHASHINI_USER_ID: dashboard userID for pipeline-config calls.
# BHASHINI_API_KEY: UDYAT KEY, sent as the `ulcaApiKey` config-call header.
#   BHASHINI_ULCA_API_KEY is accepted as an alias for the same value.
# BHASHINI_INFERENCE_KEY: dashboard INFERENCE KEY for direct Dhruva compute
#   calls (fallback if the config-call flow is unavailable).
# BHASHINI_ASR_NMT_PIPELINE_ID / BHASHINI_NMT_TTS_PIPELINE_ID: pipeline IDs
#   discovered via the official Pipeline Search + Config workflow. Both Hindi
#   flows are served by pipeline 64392f96daac500b55c543cd unless the portal
#   provisions dedicated IDs (set them here when it does).
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_INFERENCE_KEY=
BHASHINI_ASR_NMT_PIPELINE_ID=
BHASHINI_NMT_TTS_PIPELINE_ID=
BHASHINI_PIPELINE_ID=

# Sarvam API key (Saaras v3 voice-transcription fallback, server-side only)
SARVAM_API_KEY=

# Set to true to seed fictional Sahaay demo data (complainants + support cases)
# on first boot so the Support Command Center shows a representative queue.
# All demo identities are fictional.
SEED_DEMO=false